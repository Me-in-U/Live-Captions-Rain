<Window x:Class="LiveCaptionsRain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Captions Rain"
        Width="940"
        Height="940"
        MinWidth="900"
        MinHeight="940"
        Background="{StaticResource AppBackgroundBrush}"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        IsVisibleChanged="Window_IsVisibleChanged"
        Closing="Window_Closing">
    <Grid Margin="20" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="18" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,1,9,0" />
                            <TextBlock x:Name="RuntimeHeadingText" Text="Runtime" Style="{StaticResource SectionHeadingStyle}" Margin="0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="MonitorLabelText" Text="Monitor" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="MonitorCombo" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceName" Style="{StaticResource WideComboBoxStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource ControlClusterStyle}">
                            <WrapPanel>
                                <CheckBox x:Name="UseAllMonitorsCheck" Content="All monitors" />
                                <CheckBox x:Name="ClickThroughCheck" Content="Click-through" />
                                <CheckBox x:Name="InteractionModeCheck" Content="Interaction mode" />
                                <CheckBox x:Name="StackOnWindowsCheck" Content="Stack on windows" Checked="DemoPlatformSettings_Changed" Unchecked="DemoPlatformSettings_Changed" />
                                <CheckBox x:Name="WindowSideWallsCheck" Content="Window side walls" Checked="DemoPlatformSettings_Changed" Unchecked="DemoPlatformSettings_Changed" />
                                <CheckBox x:Name="FractureOnWordPilesCheck" Content="Break on word piles" />
                                <CheckBox x:Name="RandomWindCheck" Content="Random wind" Checked="DemoWindSettings_Changed" Unchecked="DemoWindSettings_Changed" />
                            </WrapPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="188" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="SpawnModeLabelText" Text="Spawn mode" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox x:Name="SpawnModeCombo" DisplayMemberPath="Display" Style="{StaticResource CompactComboBoxStyle}" SelectionChanged="DemoSpawnSettings_Changed" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="WindStrengthLabelText" Text="Wind strength" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="WindStrengthBox" Style="{StaticResource NumberTextBoxStyle}" TextChanged="DemoWindSettings_Changed" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="CaptionDelayLabelText" Text="Caption delay (ms)" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="CaptionDelayBox" Style="{StaticResource NumberTextBoxStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="CleanupLifetimeLabelText" Text="Cleanup lifetime seconds" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="CleanupLifetimeBox" Style="{StaticResource NumberTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="MaxWordsLabelText" Text="Max active words" Style="{StaticResource FormLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MaxWordsBox" Grid.Column="0" Style="{StaticResource SmallNumberTextBoxStyle}" />
                                        <TextBlock x:Name="CurrentWordCountText" Grid.Column="1" Text="(current: 0 shown)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0,0,8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="8,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" Height="18" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,1,9,0" />
                            <TextBlock x:Name="TextStyleHeadingText" Text="Text Style" Style="{StaticResource SectionHeadingStyle}" Margin="0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FormRowStyle}">
                            <TextBlock x:Name="FontFamilyLabelText" Text="Font family" Style="{StaticResource FormLabelStyle}" />
                            <ComboBox x:Name="FontFamilyCombo" DisplayMemberPath="Display" SelectedValuePath="Source" Style="{StaticResource WideComboBoxStyle}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="188" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="FontSizeLabelText" Text="Font size" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="FontSizeBox" Style="{StaticResource NumberTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="FontWeightLabelText" Text="Font weight" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox x:Name="FontWeightCombo" DisplayMemberPath="Display" Style="{StaticResource CompactComboBoxStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="StrokeThicknessLabelText" Text="Stroke thickness" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox x:Name="StrokeThicknessBox" Style="{StaticResource NumberTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FormRowStyle}">
                                    <TextBlock x:Name="OpacityLabelText" Text="Opacity" Style="{StaticResource FormLabelStyle}" />
                                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False" Margin="0,8,0,12" Style="{StaticResource CompactSliderStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource ControlClusterStyle}">
                            <WrapPanel>
                                <CheckBox x:Name="UseFillCheck" Content="Fill text" />
                                <CheckBox x:Name="ShadowCheck" Content="Shadow" />
                            </WrapPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="188" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Style="{StaticResource FormRowStyle}">
                                <TextBlock x:Name="FontColorLabelText" Text="Font color" Style="{StaticResource FormLabelStyle}" />
                                <Button x:Name="FontColorButton" Style="{StaticResource CompactColorButtonStyle}" Click="FontColor_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="FontColorSwatch" Width="18" Height="18" BorderBrush="#FFCBD5E1" BorderThickness="1" Margin="0,0,8,0" />
                                        <TextBlock x:Name="FontColorButtonText" Text="Choose color" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Style="{StaticResource FormRowStyle}">
                                <TextBlock x:Name="OutlineColorLabelText" Text="Outline color" Style="{StaticResource FormLabelStyle}" />
                                <Button x:Name="OutlineColorButton" Style="{StaticResource CompactColorButtonStyle}" Click="OutlineColor_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="OutlineColorSwatch" Width="18" Height="18" BorderBrush="#FFCBD5E1" BorderThickness="1" Margin="0,0,8,0" />
                                        <TextBlock x:Name="OutlineColorButtonText" Text="Choose color" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.ColumnSpan="2" MinHeight="300" Background="#FF050505" BorderBrush="#FF1F2937" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,16,0,0">
                    <Grid ClipToBounds="True">
                        <Canvas x:Name="DemoCanvas" ClipToBounds="True" SizeChanged="DemoCanvas_SizeChanged" />
                        <Button x:Name="RefreshDemoButton" Width="34" Height="34" MinWidth="34" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Click="RefreshDemo_Click">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{x:Null}" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M21,2 L21,8 L15,8 M3,12 A9,9 0 0,1 18,5.3 L21,8 M3,22 L3,16 L9,16 M21,12 A9,9 0 0,1 6,18.7 L3,16" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

        <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LiveCaptionsToggleButton" Content="Live Captions" Click="LiveCaptionsToggle_Click" />
                <Button x:Name="ToggleRunningButton" Content="Turn On" Click="ToggleRunning_Click" />
                <Button x:Name="ApplyAndSaveButton" Content="Apply and Save" Click="ApplyAndSave_Click" />
                <Button x:Name="ExitButton" Content="Exit" Click="Exit_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
